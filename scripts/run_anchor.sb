#!/bin/bash
#SBATCH --job-name=gen_anchor
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --time=00:30:00
#SBATCH --output=logs/anchor_%j.log
#SBATCH --mem=8G

# Load Python
module load python/3.11.2

# Activate Environment
source venv_gpu_test/bin/activate

# Set HF Token (Ensure this is set in your env or replace here)
# export HF_TOKEN="<YOUR_HF_TOKEN>" 

# Input: A known clean file where Ellie speaks clearly.
# Ideally, just 10-30 seconds of her speaking.
# Replace this path with a real file on the cluster!
INPUT_AUDIO="data/01_raw/300_AUDIO.wav" 
OUTPUT_FILE="data/ellie_anchor.npy"

echo "Generating anchor from $INPUT_AUDIO..."

python src/generate_anchor.py \
    --audio $INPUT_AUDIO \
    --output $OUTPUT_FILE

echo "Done."
