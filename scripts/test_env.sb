#!/bin/bash
#SBATCH --job-name=test_env
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --time=00:05:00
#SBATCH --output=logs/test_env_%j.out

mkdir -p logs

echo "========================================"
echo "DEBUGGING PYTHON PATHS"
echo "========================================"

# 1. Check Base Paths
echo "Checking /cm/shared/omni/apps/python/3.11.2 ..."
if [ -d "/cm/shared/omni/apps/python/3.11.2" ]; then
    echo " -> FOUND! This is likely the correct PYTHONHOME."
    FOUND_HOME="/cm/shared/omni/apps/python/3.11.2"
else
    echo " -> NOT FOUND."
fi

echo "Checking /usr/lib64/python3.11 ..."
if [ -d "/usr/lib64/python3.11" ]; then
    echo " -> FOUND /usr/lib64/python3.11"
else
    echo " -> NOT FOUND /usr/lib64/python3.11"
fi

# 2. Activate Venv (Standard)
source venv_gpu_test/bin/activate

# 3. Test Fix: Manually Set PYTHONHOME
# We assume the venv was created from the /cm/shared... python
echo "----------------------------------------"
echo "TEST: Setting PYTHONHOME manually"

# Unset conflicting vars first
unset PYTHONPATH

# Validate where we are pointing
if [ ! -z "$FOUND_HOME" ]; then
    export PYTHONHOME=$FOUND_HOME
    echo "Set PYTHONHOME=$FOUND_HOME"
    
    # Also ensure lib path is correct
    export LD_LIBRARY_PATH="$HOME/venv_gpu_test/lib:$LD_LIBRARY_PATH"
    
    # Verify
    $HOME/venv_gpu_test/bin/python -c "import sys; print(f'SUCCESS! sys.path is: {sys.path}')" || echo "FAIL: Still crashed."
else
    echo "Skipping test: Could not identify base python home."
fi

echo "========================================"
echo "DONE"
