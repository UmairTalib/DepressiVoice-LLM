#!/bin/bash
#SBATCH --job-name=setup_clean
#SBATCH --partition=gpu
#SBATCH --time=00:45:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --mem=8G
#SBATCH --output=logs/setup_clean_%j.out

mkdir -p logs

echo "======================================================"
echo "Setup Clean Venv (Standard Symlinks)"
echo "======================================================"

# 1. Load Modules (The config that worked originally)
module purge
module load GpuModules

# FORCE Python 3.11 from Shared Apps
export PATH=/cm/shared/omni/apps/python/3.11.2/bin:$PATH
export LD_LIBRARY_PATH=/cm/shared/omni/apps/python/3.11.2/lib:$LD_LIBRARY_PATH

echo "Python Version Host:"
which python3
python3 --version

# 2. Create Venv (Standard, NO --copies)
# This relies on /cm/shared being accessible on compute nodes (usually true).
ENV_NAME="venv_cluster"

if [ -d "$ENV_NAME" ]; then
    echo "removing old $ENV_NAME..."
    rm -rf "$ENV_NAME"
fi

echo "Creating $ENV_NAME..."
python3 -m venv "$ENV_NAME"

# 3. Activate
source "$ENV_NAME/bin/activate"
echo "Activated Python: $(which python)"

# 4. Install Deps
echo "Installing Dependencies..."
python -m pip install --upgrade pip --no-cache-dir

# Install Rust/Build tools just in case, though we want wheels
pip install wheel setuptools --no-cache-dir

# Install Safetensors explicitly first (binary wheel)
pip install safetensors --no-cache-dir

# Install Torch (CUDA 11.8 compatible)
pip install torch torchaudio --index-url https://download.pytorch.org/whl/cu118 --no-cache-dir

# Install Project Deps
pip install transformers librosa soundfile numpy pandas tqdm pyyaml scikit-learn --no-cache-dir

# 5. Verify
echo "======================================================"
echo "Verification:"
python -c "import torch; print(f'Torch: {torch.__version__}'); print(f'CUDA Available: {torch.cuda.is_available()}')"
echo "======================================================"
