#!/bin/bash
#SBATCH --job-name=verify_align
#SBATCH --output=experiments/verify_align_%j.out
#SBATCH --error=experiments/verify_align_%j.err
#SBATCH --partition=gpu
#SBATCH --gres=gpu:0
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=00:30:00

# Load Environment
module load miniconda3/4.9.2
source /opt/conda/etc/profile.d/conda.sh 2>/dev/null || source $HOME/miniconda3/etc/profile.d/conda.sh 2>/dev/null || source $CONDA_PREFIX/etc/profile.d/conda.sh 2>/dev/null
conda activate depressivoice-phase1

echo "🚀 Starting Temporal Alignment Verification"
echo "📅 Date: $(date)"

# Install pandas if missing (it should be there)
pip install pandas || echo "Pandas install failed/already exists"

# Run Verification
python src/phase3_fusion/verify_alignment.py \
    --audio_dir /home/g755389/DepressiVoice-LLM/data/03_features/audio_embeddings_clean/ \
    --phase1_dir /home/g755389/DepressiVoice-LLM/data/processed/phase1/session_outputs/ \
    --output experiments/alignment_verification_report.csv

echo "✅ Verification Complete"
