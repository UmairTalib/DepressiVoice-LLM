#!/bin/bash
#SBATCH --job-name=setup_simple
#SBATCH --partition=gpu
#SBATCH --time=00:30:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --mem=8G
#SBATCH --output=logs/setup_simple_%j.out

mkdir -p logs

echo "======================================================"
echo "Back to Basics: Standard Venv Setup"
echo "======================================================"

# 1. Load Modules (Same as original success)
module load GpuModules

# 2. Create Venv (Standard Symlinks, NO --copies)
# This worked for verify_setup.py
if [ -d "venv_simple" ]; then
    echo "venv_simple exists. skipping create."
else
    echo "Creating venv_simple..."
    python3 -m venv venv_simple
fi

# 3. Activate
source venv_simple/bin/activate
echo "Python: $(which python)"
python --version

# 4. Install Deps
# Fix pip first
python -m pip install --upgrade pip

# Install ONLY what we need for extraction
# Index URL for CUDA 11.8
pip install torch torchaudio --index-url https://download.pytorch.org/whl/cu118
pip install transformers librosa soundfile numpy pandas tqdm pyyaml

echo "======================================================"
echo "Simple Setup COMPLETE"
echo "======================================================"
