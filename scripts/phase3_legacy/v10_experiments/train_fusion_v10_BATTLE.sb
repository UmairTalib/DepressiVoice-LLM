#!/bin/bash
#SBATCH --job-name=v10_BATTLE
#SBATCH --output=experiments/v10_BATTLE/slurm_%j.out
#SBATCH --error=experiments/v10_BATTLE/slurm_%j.err
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:1
#SBATCH --mem=32G
#SBATCH --time=08:00:00

# Load environment
module load miniconda3/4.9.2
source /opt/conda/etc/profile.d/conda.sh 2>/dev/null || source $HOME/miniconda3/etc/profile.d/conda.sh 2>/dev/null || source $CONDA_PREFIX/etc/profile.d/conda.sh 2>/dev/null
conda activate depressivoice-phase1

cd /home/g755389/DepressiVoice-LLM

# --- Experiment A: Standard Baseline Optimized (Weight 3.2, Dropout 0.25) ---
# mkdir -p experiments/v10_BATTLE/RunA_Standard_Balanced
# python3 src/phase3_fusion/train.py \
#     --audio_dir data/phase2_clean/audio_embeddings_normalized/ \
#     --text_dir data/phase2_clean/text_embeddings_clean/ \
#     --labels_csv data/01_raw/detailed_lables_REVISED.csv \
#     --leakage_json docs/reports/ellie_leakage_audit.json \
#     --output_dir experiments/v10_BATTLE/RunA_Standard_Balanced \
#     --epochs 100 --dropout 0.25 --pos_weight 3.2 --lr 1e-4

# --- Experiment B: The PRO Baseline (Focal Loss + Deep Adapters) ---
mkdir -p experiments/v10_BATTLE/RunB_PRO_Focal
python3 src/phase3_fusion/train_pro.py \
    --audio_dir data/phase2_clean/audio_embeddings_normalized/ \
    --text_dir data/phase2_clean/text_embeddings_clean/ \
    --labels_csv data/01_raw/detailed_lables_REVISED.csv \
    --leakage_json docs/reports/ellie_leakage_audit.json \
    --output_dir experiments/v10_BATTLE/RunB_PRO_Focal \
    --epochs 100 --dropout 0.3 --pos_weight 2.5 --gamma 2.0 --lr 1e-4

echo "⚔️ The v10 Battle is complete. Check 'experiments/v10_BATTLE/' for results."
