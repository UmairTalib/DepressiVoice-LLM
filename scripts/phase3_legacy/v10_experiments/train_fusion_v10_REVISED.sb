#!/bin/bash
#SBATCH --job-name=fusion_v10_REVISED
#SBATCH --output=experiments/fusion_v10_REVISED/slurm_%j.out
#SBATCH --error=experiments/fusion_v10_REVISED/slurm_%j.err
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:1
#SBATCH --mem=32G
#SBATCH --time=04:00:00

# Load modules and activate environment
module load miniconda3/4.9.2
source /opt/conda/etc/profile.d/conda.sh 2>/dev/null || source $HOME/miniconda3/etc/profile.d/conda.sh 2>/dev/null || source $CONDA_PREFIX/etc/profile.d/conda.sh 2>/dev/null
conda activate depressivoice-phase1

cd /home/g755389/DepressiVoice-LLM

mkdir -p experiments/fusion_v10_REVISED

echo "🚀 Training Fusion V10 (BASELINE) with REVISED Labels"

python3 src/phase3_fusion/train.py \
    --audio_dir /home/g755389/DepressiVoice-LLM/data/phase2_clean/audio_embeddings_normalized/ \
    --text_dir /home/g755389/DepressiVoice-LLM/data/phase2_clean/text_embeddings_clean/ \
    --labels_csv /home/g755389/DepressiVoice-LLM/data/01_raw/detailed_lables_REVISED.csv \
    --leakage_json /home/g755389/DepressiVoice-LLM/docs/reports/ellie_leakage_audit.json \
    --output_dir experiments/fusion_v10_REVISED \
    --epochs 100 \
    --dropout 0.1 \
    --pos_weight 5.0 \
    --seed 42

echo "✅ Training Complete."
