#!/bin/bash
#SBATCH --job-name=v11_PRO
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --output=experiments/v11_PRO/slurm_%j.out
#SBATCH --error=experiments/v11_PRO/slurm_%j.err

# 1. Environment and Directories
cd ~/DepressiVoice-LLM
source /opt/conda/etc/profile.d/conda.sh 2>/dev/null || source $HOME/miniconda3/etc/profile.d/conda.sh 2>/dev/null || source $CONDA_PREFIX/etc/profile.d/conda.sh 2>/dev/null
conda activate depressivoice-phase1

mkdir -p experiments/v11_PRO

# 2. Execution - PHENOTYPE ANCHORED FUSION (MTL)
python3 src/phase3_fusion/train_max.py \
    --root_dir ./ \
    --labels_csv data/01_raw/detailed_lables.csv \
    --output_dir experiments/v11_PRO \
    --lr 1e-4 \
    --epochs 100 \
    --pos_weight 3.2 \
    --ortho_lambda 0.1 \
    --mse_lambda 0.5

echo "✅ High-Resolution MTL SOTA Hunt Complete."
