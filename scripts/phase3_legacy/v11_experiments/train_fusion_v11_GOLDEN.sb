#!/bin/bash
#SBATCH --job-name=v11_GOLDEN_MIDDLE
#SBATCH --output=experiments/fusion_v11_GOLDEN/slurm_%j.out
#SBATCH --error=experiments/fusion_v11_GOLDEN/slurm_%j.err
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:1
#SBATCH --mem=32G
#SBATCH --time=04:00:00

# Load modules and activate environment
module load miniconda3/4.9.2
source /opt/conda/etc/profile.d/conda.sh 2>/dev/null || source $HOME/miniconda3/etc/profile.d/conda.sh 2>/dev/null || source $CONDA_PREFIX/etc/profile.d/conda.sh 2>/dev/null
conda activate depressivoice-phase1

cd /home/g755389/DepressiVoice-LLM

mkdir -p experiments/fusion_v11_GOLDEN

echo "🚀 Training Gated Fusion (v11) with REVISED Labels + GOLDEN MIDDLE (3.2 Weight)"

python3 -u src/phase3_fusion_v11/train.py \
    --root_dir /home/g755389/DepressiVoice-LLM/ \
    --save_dir experiments/fusion_v11_GOLDEN \
    --labels_csv data/01_raw/detailed_lables_REVISED.csv \
    --pos_weight 3.2 \
    --epochs 100

echo "✅ Training Complete."
