#!/bin/bash
#SBATCH --job-name=v11_MAX_SOTA
#SBATCH --output=experiments/v11_MAX/slurm_%j.out
#SBATCH --error=experiments/v11_MAX/slurm_%j.err
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:1
#SBATCH --mem=32G
#SBATCH --time=04:00:00

# Load modules and activate environment
module load miniconda3/4.9.2
source /opt/conda/etc/profile.d/conda.sh 2>/dev/null || source $HOME/miniconda3/etc/profile.d/conda.sh 2>/dev/null || source $CONDA_PREFIX/etc/profile.d/conda.sh 2>/dev/null
conda activate depressivoice-phase1

cd /home/g755389/DepressiVoice-LLM

mkdir -p experiments/v11_MAX

echo "👑 Launching the Final Boss: Phase 3.5 MAX (SOTA-Search)"

# Using ORIGINAL LABELS to aim for maximum score compatible with existing literature
python3 -u src/phase3_fusion/train_max.py \
    --root_dir /home/g755389/DepressiVoice-LLM/ \
    --labels_csv data/01_raw/detailed_lables.csv \
    --output_dir experiments/v11_MAX \
    --pos_weight 3.2 \
    --lr 1e-4 \
    --ortho_lambda 0.1 \
    --epochs 100

echo "✅ SOTA Hunt Complete."
