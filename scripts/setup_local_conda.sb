#!/bin/bash
#SBATCH --job-name=setup_local_conda
#SBATCH --partition=gpu
#SBATCH --time=01:00:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --mem=8G
#SBATCH --output=logs/setup_local_conda_%j.out

mkdir -p logs

echo "======================================================"
echo "Installing LOCAL Miniconda (Self-Contained)"
echo "======================================================"

# 1. Download Installer
INSTALLER="Miniconda3-latest-Linux-x86_64.sh"
if [ ! -f "$INSTALLER" ]; then
    echo "Downloading $INSTALLER..."
    wget https://repo.anaconda.com/miniconda/$INSTALLER -O $INSTALLER
fi

# 2. Install
PREFIX="$HOME/miniconda3"
if [ -d "$PREFIX" ]; then
    echo "Directory $PREFIX exists. Deleting to reinstall..."
    rm -rf "$PREFIX"
fi

echo "Installing to $PREFIX..."
bash $INSTALLER -b -p $PREFIX

# 3. Setup Shell (Init)
echo "Initializing..."
source $PREFIX/bin/activate
conda init bash

# 4. Create Env
ENV_NAME="depressivoice_env"
echo "Creating Environment $ENV_NAME..."
conda create -n $ENV_NAME python=3.10 -y

# 5. Connect and Install Deps
conda activate $ENV_NAME
echo "Python: $(which python)"
python --version

# Upgrade Pip
pip install --upgrade pip --no-cache-dir

# Install Deps (Using PyPi for full compatibility/speed)
pip install torch torchaudio --index-url https://download.pytorch.org/whl/cu118 --no-cache-dir
pip install transformers librosa soundfile numpy pandas tqdm pyyaml scikit-learn safetensors --no-cache-dir

echo "======================================================"
echo "Local Conda Setup COMPLETE"
echo "======================================================"
