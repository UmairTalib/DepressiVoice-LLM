#!/bin/bash
#SBATCH --job-name=phase1_env_check
#SBATCH --output=%x_%j.out
#SBATCH --error=%x_%j.err
#SBATCH --partition=__SLURM_PARTITION__
#SBATCH --time=__SLURM_TIME__
#SBATCH --mem=__SLURM_MEM__
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gres=gpu:0

################################################################################
# 03_env_check.sbatch
# SLURM batch script for environment validation on compute node
# Creates/activates conda env, installs packages, runs validation
################################################################################

set -euo pipefail

# This script will be auto-generated by setup process
# Placeholders will be replaced with actual values from cluster_config.env

echo "========================================"
echo "SLURM Environment Check Job"
echo "========================================"
echo "Job ID: $SLURM_JOB_ID"
echo "Node: $SLURMD_NODENAME"
echo "Partition: $SLURM_JOB_PARTITION"
echo "Started: $(date -u)"
echo "========================================" 
echo ""

# Source configuration (will be set by deployment script)
export OUT_ROOT="__OUT_ROOT__"
export CONDA_ENV="__CONDA_ENV__"
export CONDA_MODULE="__CONDA_MODULE__"
export REPO_ROOT="__REPO_ROOT__"

LOG_DIR="$OUT_ROOT/env_install_logs"
ACTION_LOG="$LOG_DIR/actions.log"
SLURM_LOG="$LOG_DIR/slurm_job_${SLURM_JOB_ID}.log"

mkdir -p "$LOG_DIR"

log_action() {
  local timestamp=$(date -u +"%Y-%m-%d %H:%M:%S UTC")
  echo "[$timestamp] $1" | tee -a "$ACTION_LOG" | tee -a "$SLURM_LOG"
}

log_action "=========================================="
log_action "COMPUTE NODE: Environment installation"
log_action "=========================================="
log_action "SLURM_JOB_ID: $SLURM_JOB_ID"
log_action "SLURMD_NODENAME: $SLURMD_NODENAME"
log_action "OUT_ROOT: $OUT_ROOT"
log_action "CONDA_ENV: $CONDA_ENV"

# Load conda module if specified
if [ -n "$CONDA_MODULE" ]; then
  log_action "Loading conda module: $CONDA_MODULE"
  module load "$CONDA_MODULE" 2>&1 | tee -a "$SLURM_LOG"
fi

# Initialize conda for bash if not already done
if command -v conda &>/dev/null; then
  log_action "Initializing conda..."
  eval "$(conda shell.bash hook)"
else
  log_action "❌ ERROR: conda not available even after module load"
  exit 1
fi

# Check if conda env exists, create if not
if conda env list | grep -q "^${CONDA_ENV} "; then
  log_action "✓ Conda environment '$CONDA_ENV' already exists"
  log_action "Activating environment..."
  conda activate "$CONDA_ENV" 2>&1 | tee -a "$SLURM_LOG"
else
  log_action "Creating new conda environment: $CONDA_ENV"
  conda create -n "$CONDA_ENV" python=3.10 -y 2>&1 | tee -a "$SLURM_LOG"
  
  log_action "Activating environment..."
  conda activate "$CONDA_ENV" 2>&1 | tee -a "$SLURM_LOG"
  
  log_action "Upgrading pip..."
  pip install --upgrade pip 2>&1 | tee -a "$SLURM_LOG"
fi

# Verify activation
log_action "Active Python: $(which python)"
log_action "Python version: $(python --version)"

# Install packages from requirements
REQUIREMENTS_FILE="$REPO_ROOT/cluster_scripts/phase1_setup/requirements_phase1.txt"

if [ -f "$REQUIREMENTS_FILE" ]; then
  log_action "Installing packages from: $REQUIREMENTS_FILE"
  pip install --no-cache-dir -r "$REQUIREMENTS_FILE" 2>&1 | tee -a "$SLURM_LOG"
else
  log_action "⚠️  Requirements file not found: $REQUIREMENTS_FILE"
  log_action "Installing core packages individually..."
  
  pip install --no-cache-dir \
    pandas numpy scikit-learn matplotlib seaborn \
    librosa torchaudio torch transformers \
    PyYAML tqdm python-dotenv scipy 2>&1 | tee -a "$SLURM_LOG"
fi

log_action "✓ Package installation completed"
log_action ""

# Run validation script
VALIDATION_SCRIPT="$REPO_ROOT/cluster_scripts/phase1_setup/validate_imports.py"

if [ -f "$VALIDATION_SCRIPT" ]; then
  log_action "Running validation script: $VALIDATION_SCRIPT"
  log_action "=========================================="
  
  export OUT_ROOT="$OUT_ROOT"
  python "$VALIDATION_SCRIPT" 2>&1 | tee -a "$SLURM_LOG"
  
  VALIDATION_EXIT=$?
  log_action "=========================================="
  log_action "Validation script exit code: $VALIDATION_EXIT"
else
  log_action "❌ ERROR: Validation script not found: $VALIDATION_SCRIPT"
  exit 1
fi

log_action ""
log_action "=========================================="
log_action "SLURM job completed"
log_action "Ended: $(date -u)"
log_action "=========================================="

exit $VALIDATION_EXIT
